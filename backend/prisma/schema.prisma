// LiFa — MVP Prisma schema.
// Conventions:
//   - Prisma model fields use camelCase; DB columns use snake_case via @map.
//   - All money values are Decimal(19,4). Never float.
//   - Every business table is company-scoped (company_id FK).
//   - Document numbers (invoice_number, entry_number) are NULL while draft,
//     assigned only on issue/post via the DocumentSequence table.
//   - Posted journal entries are immutable. Voids are reversal entries that
//     also stay POSTED; status enum has only DRAFT and POSTED.
// See IMPLEMENTATION_PLAN.md Step 2 for the full specification.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum LegalForm {
  BI
  OP
  KO
  SHPK
  SHA
  FOREIGN_BRANCH
  NGO
  OTHER
}

enum AddressType {
  REGISTERED
  BUSINESS
  OTHER
}

enum ActivityType {
  PRIMARY
  SECONDARY
}

enum AccountRole {
  ACCOUNTS_RECEIVABLE
  CASH
  BANK
  VAT_PAYABLE
  SALES_REVENUE
  ACCOUNTS_PAYABLE // Phase 1 (purchases/AP)
  VAT_RECEIVABLE // input VAT on purchases
  EXPENSE // default expense account for bill lines
}

enum ProductServiceType {
  PRODUCT
  SERVICE
}

enum TaxCalculationType {
  EXCLUSIVE
  INCLUSIVE
}

enum TaxScope {
  SALES
  PURCHASES
  BOTH
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum PeriodStatus {
  OPEN
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentType {
  RECEIVED
  MADE // reserved for post-MVP (purchase payments); MVP issues RECEIVED only
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  RECORDED
  VOID
}

enum JournalEntryStatus {
  DRAFT
  POSTED
}

enum DocumentType {
  INVOICE
  JOURNAL_ENTRY
  CREDIT_NOTE
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// Phase 1 — Purchases / Accounts Payable. OPEN = posted, awaiting payment.
enum BillStatus {
  DRAFT
  OPEN
  PARTIALLY_PAID
  PAID
  VOID
}

// Credit Notes — sales returns (reduce AR) or vendor credits (reduce AP).
enum CreditNoteType {
  SALES // reduces customer AR; reverses revenue
  PURCHASE // reduces vendor AP; reverses expense
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  VOID
}

// --- Fiscalization (Kosovo / ATK) — see FISCALIZATION.md ---

enum FiscalProvider {
  NONE // fiscalization disabled
  MANUAL_EDI // operator records FCUIN/QR from ATK's EDI portal / tax block
  ATK_EFS // certified Electronic Fiscal Software gateway (integration point)
}

enum FiscalCouponStatus {
  PENDING // awaiting fiscalization
  FISCALIZED // FCUIN + QR obtained from ATK
  FAILED // provider returned an error
  VOIDED // coupon reversed (e.g. invoice voided)
  EXEMPT // sale out of fiscalization scope
}

enum FiscalCouponType {
  SALE
  RETURN
}

// ---------------------------------------------------------------------------
// Platform / Auth
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  email        String   @unique
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  companyAccess    UserCompanyAccess[]
  createdCompanies Company[]           @relation("CompanyCreatedBy")
  createdContacts  Contact[]           @relation("ContactCreatedBy")
  createdProducts  ProductService[]    @relation("ProductCreatedBy")
  createdAccounts  Account[]           @relation("AccountCreatedBy")
  closedPeriods    AccountingPeriod[]  @relation("PeriodClosedBy")
  postedJournals   JournalEntry[]      @relation("JournalPostedBy")
  createdJournals  JournalEntry[]      @relation("JournalCreatedBy")
  createdInvoices  Invoice[]           @relation("InvoiceCreatedBy")
  createdPayments  Payment[]           @relation("PaymentCreatedBy")
  createdAllocs    PaymentAllocation[] @relation("AllocationCreatedBy")
  createdBills     Bill[]              @relation("BillCreatedBy")
  createdCreditNotes CreditNote[]    @relation("CreditNoteCreatedBy")
  auditLogs        AuditLog[]
  createdWarehouses   Warehouse[]      @relation("WarehouseCreatedBy")
  createdStockMovements StockMovement[] @relation("StockMovementCreatedBy")
  posSessionsOpened   PosSession[]     @relation("PosSessionOpenedBy")
  posSessionsClosed   PosSession[]     @relation("PosSessionClosedBy")
  posSales            PosSale[]        @relation("PosSaleCreatedBy")
  quotes              Quote[]          @relation("QuoteCreatedBy")
  salesOrders         SalesOrder[]     @relation("SalesOrderCreatedBy")
  employees           Employee[]       @relation("EmployeeCreatedBy")
  payrollRuns         PayrollRun[]     @relation("PayrollRunCreatedBy")
  fixedAssets         FixedAsset[]     @relation("FixedAssetCreatedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // owner | admin | accountant | viewer
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userCompanyAccess UserCompanyAccess[]

  @@map("roles")
}

model UserCompanyAccess {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("user_company_access")
}

// ---------------------------------------------------------------------------
// Company
// ---------------------------------------------------------------------------

model Company {
  id                   String    @id @default(uuid()) @db.Uuid
  legalName            String    @map("legal_name")
  tradeName            String?   @map("trade_name")
  legalForm            LegalForm @map("legal_form")
  uinNui               String?   @map("uin_nui")
  fiscalNumber         String?   @map("fiscal_number")
  vatNumber            String?   @map("vat_number")
  registrationDate     DateTime? @map("registration_date") @db.Date
  email                String?
  phone                String?
  website              String?
  defaultCurrency      String    @default("EUR") @map("default_currency")
  fiscalYearStartMonth Int       @default(1) @map("fiscal_year_start_month")
  createdBy            String    @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  creator           User                     @relation("CompanyCreatedBy", fields: [createdBy], references: [id])
  userAccess        UserCompanyAccess[]
  addresses         CompanyAddress[]
  activityCodes     CompanyActivityCode[]
  accountDefaults   CompanyAccountDefaults[]
  contacts          Contact[]
  productsServices  ProductService[]
  taxRates          TaxRate[]
  accounts          Account[]
  periods           AccountingPeriod[]
  journalEntries    JournalEntry[]
  invoices          Invoice[]
  bills             Bill[]
  creditNotes       CreditNote[]
  payments          Payment[]
  documentSequences DocumentSequence[]
  auditLogs         AuditLog[]
  fiscalConfig      CompanyFiscalConfig?
  fiscalCoupons     FiscalCoupon[]
  warehouses        Warehouse[]
  stockMovements    StockMovement[]
  posRegisters      PosRegister[]
  posSessions       PosSession[]
  posSales          PosSale[]
  quotes            Quote[]
  salesOrders       SalesOrder[]
  exchangeRates     ExchangeRate[]
  employees         Employee[]
  payrollRuns       PayrollRun[]
  fixedAssets       FixedAsset[]

  @@map("companies")
}

model CompanyAddress {
  id           String      @id @default(uuid()) @db.Uuid
  companyId    String      @map("company_id") @db.Uuid
  addressType  AddressType @map("address_type")
  country      String?
  municipality String?
  city         String?
  street       String?
  postalCode   String?     @map("postal_code")
  isPrimary    Boolean     @default(false) @map("is_primary")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_addresses")
}

model CompanyActivityCode {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @map("company_id") @db.Uuid
  activityType ActivityType @map("activity_type")
  code         String
  description  String?
  sortOrder    Int          @default(0) @map("sort_order")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("company_activity_codes")
}

model CompanyAccountDefaults {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @map("company_id") @db.Uuid
  accountRole AccountRole @map("account_role")
  accountId   String      @map("account_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@unique([companyId, accountRole])
  @@index([companyId])
  @@map("company_account_defaults")
}

// ---------------------------------------------------------------------------
// Contacts
// ---------------------------------------------------------------------------

// CHECK (is_customer = true OR is_vendor = true) is enforced via raw SQL
// added to the initial migration — Prisma does not support CHECK constraints.
model Contact {
  id               String   @id @default(uuid()) @db.Uuid
  companyId        String   @map("company_id") @db.Uuid
  isCustomer       Boolean  @default(false) @map("is_customer")
  isVendor         Boolean  @default(false) @map("is_vendor")
  displayName      String   @map("display_name")
  legalName        String?  @map("legal_name")
  email            String?
  phone            String?
  taxId            String?  @map("tax_id")
  paymentTermsDays Int?     @map("payment_terms_days")
  currency         String   @default("EUR")
  country          String?
  municipality     String?
  city             String?
  street           String?
  postalCode       String?  @map("postal_code")
  isActive         Boolean  @default(true) @map("is_active")
  notes            String?
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator           User               @relation("ContactCreatedBy", fields: [createdBy], references: [id])
  invoices          Invoice[]
  bills             Bill[]
  creditNotes       CreditNote[]
  payments          Payment[]
  journalEntryLines JournalEntryLine[]
  quotes            Quote[]
  salesOrders       SalesOrder[]

  @@index([companyId])
  @@index([companyId, isCustomer])
  @@index([companyId, isVendor])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model ProductService {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  type             ProductServiceType
  sku              String?
  name             String
  description      String?
  unit             String?
  salePrice        Decimal?           @map("sale_price") @db.Decimal(19, 4)
  purchasePrice    Decimal?           @map("purchase_price") @db.Decimal(19, 4)
  incomeAccountId  String?            @map("income_account_id") @db.Uuid
  expenseAccountId String?            @map("expense_account_id") @db.Uuid
  defaultTaxRateId String?            @map("default_tax_rate_id") @db.Uuid
  isActive         Boolean            @default(true) @map("is_active")
  createdBy        String             @map("created_by") @db.Uuid
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator        User          @relation("ProductCreatedBy", fields: [createdBy], references: [id])
  incomeAccount  Account?      @relation("ProductIncomeAccount", fields: [incomeAccountId], references: [id])
  expenseAccount Account?      @relation("ProductExpenseAccount", fields: [expenseAccountId], references: [id])
  defaultTaxRate TaxRate?      @relation(fields: [defaultTaxRateId], references: [id])
  invoiceLines     InvoiceLine[]
  billLines        BillLine[]
  creditNoteLines  CreditNoteLine[]
  stockMovements     StockMovement[]
  posSaleLines       PosSaleLine[]
  quoteLines         QuoteLine[]
  salesOrderLines    SalesOrderLine[]

  @@index([companyId])
  @@map("products_services")
}

// ---------------------------------------------------------------------------
// Tax
// ---------------------------------------------------------------------------

// company_id is nullable here because system-level tax rate templates
// (Standard 18%, Reduced 8%, Zero/Exempt 0%) live with company_id = NULL
// and are copied per-company during CompanySetupService.seedDefaults.
model TaxRate {
  id              String             @id @default(uuid()) @db.Uuid
  companyId       String?            @map("company_id") @db.Uuid
  name            String
  code            String
  rate            Decimal            @db.Decimal(19, 4)
  calculationType TaxCalculationType @map("calculation_type")
  scope           TaxScope
  isDefault       Boolean            @default(false) @map("is_default")
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  company          Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productsServices ProductService[]
  invoiceLines     InvoiceLine[]
  billLines        BillLine[]
  creditNoteLines  CreditNoteLine[]

  @@index([companyId])
  @@map("tax_rates")
}

// ---------------------------------------------------------------------------
// Accounting
// ---------------------------------------------------------------------------

model Account {
  id              String        @id @default(uuid()) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  code            String
  name            String
  accountType     AccountType   @map("account_type")
  accountSubtype  String?       @map("account_subtype")
  normalBalance   NormalBalance @map("normal_balance")
  parentAccountId String?       @map("parent_account_id") @db.Uuid
  isPostable      Boolean       @default(true) @map("is_postable")
  isSystem        Boolean       @default(false) @map("is_system")
  isActive        Boolean       @default(true) @map("is_active")
  createdBy       String        @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  company            Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator            User                     @relation("AccountCreatedBy", fields: [createdBy], references: [id])
  parentAccount      Account?                 @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  childAccounts      Account[]                @relation("AccountHierarchy")
  journalEntryLines   JournalEntryLine[]
  productsIncome      ProductService[]         @relation("ProductIncomeAccount")
  productsExpense     ProductService[]         @relation("ProductExpenseAccount")
  invoiceLinesIncome  InvoiceLine[]
  billLinesExpense    BillLine[]
  creditNoteLinesAcct CreditNoteLine[]
  companyDefaults     CompanyAccountDefaults[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("accounts")
}

model AccountingPeriod {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @map("company_id") @db.Uuid
  fiscalYear   Int          @map("fiscal_year")
  periodNumber Int          @map("period_number")
  startDate    DateTime     @map("start_date") @db.Date
  endDate      DateTime     @map("end_date") @db.Date
  status       PeriodStatus @default(OPEN)
  closedAt     DateTime?    @map("closed_at")
  closedBy     String?      @map("closed_by") @db.Uuid
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  closedByUser   User?          @relation("PeriodClosedBy", fields: [closedBy], references: [id])
  journalEntries JournalEntry[]

  @@unique([companyId, fiscalYear, periodNumber])
  @@index([companyId])
  @@map("accounting_periods")
}

// Unique constraint on (companyId, entryNumber) is implemented as a PARTIAL
// index (WHERE entry_number IS NOT NULL) via raw SQL in the initial migration —
// Prisma does not support partial unique indexes.
model JournalEntry {
  id                 String             @id @default(uuid()) @db.Uuid
  companyId          String             @map("company_id") @db.Uuid
  entryNumber        String?            @map("entry_number") // null while DRAFT, set on POST
  entryDate          DateTime           @map("entry_date") @db.Date
  periodId           String?            @map("period_id") @db.Uuid // assigned on post
  sourceDocumentType String?            @map("source_document_type") // MANUAL | INVOICE | PAYMENT | INVOICE_VOID | PAYMENT_VOID
  sourceDocumentId   String?            @map("source_document_id") @db.Uuid
  memo               String?
  status             JournalEntryStatus @default(DRAFT)
  postedAt           DateTime?          @map("posted_at")
  postedBy           String?            @map("posted_by") @db.Uuid
  reversalOfEntryId  String?            @map("reversal_of_entry_id") @db.Uuid // set on reversal entries
  reversedByEntryId  String?            @unique @map("reversed_by_entry_id") @db.Uuid // set on original when reversed
  createdBy          String             @map("created_by") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  company         Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator         User               @relation("JournalCreatedBy", fields: [createdBy], references: [id])
  postedByUser    User?              @relation("JournalPostedBy", fields: [postedBy], references: [id])
  period          AccountingPeriod?  @relation(fields: [periodId], references: [id])
  reversalOf      JournalEntry?      @relation("JournalReversal", fields: [reversalOfEntryId], references: [id])
  reversalEntries JournalEntry[]     @relation("JournalReversal")
  reversedBy      JournalEntry?      @relation("JournalReversedBy", fields: [reversedByEntryId], references: [id])
  reversesEntry   JournalEntry?      @relation("JournalReversedBy")
  lines           JournalEntryLine[]
  postedInvoices  Invoice[]          @relation("InvoicePostedEntry")
  voidedInvoices  Invoice[]          @relation("InvoiceVoidedEntry")
  postedPayments  Payment[]          @relation("PaymentPostedEntry")
  voidedPayments  Payment[]          @relation("PaymentVoidedEntry")
  postedBills        Bill[]             @relation("BillPostedEntry")
  voidedBills        Bill[]             @relation("BillVoidedEntry")
  postedCreditNotes  CreditNote[]       @relation("CreditNotePostedEntry")
  voidedCreditNotes  CreditNote[]       @relation("CreditNoteVoidedEntry")

  @@index([companyId])
  @@index([companyId, entryDate, status])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String   @id @default(uuid()) @db.Uuid
  journalEntryId String   @map("journal_entry_id") @db.Uuid
  lineNumber     Int      @map("line_number")
  accountId      String   @map("account_id") @db.Uuid
  description    String?
  debitAmount    Decimal  @default(0) @map("debit_amount") @db.Decimal(19, 4)
  creditAmount   Decimal  @default(0) @map("credit_amount") @db.Decimal(19, 4)
  currency       String   @default("EUR")
  exchangeRate   Decimal  @default(1) @map("exchange_rate") @db.Decimal(19, 4)
  contactId      String?  @map("contact_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id])
  contact      Contact?     @relation(fields: [contactId], references: [id])

  @@index([journalEntryId, accountId])
  @@map("journal_entry_lines")
}

// ---------------------------------------------------------------------------
// Fixed Assets
// ---------------------------------------------------------------------------

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

enum AssetStatus {
  ACTIVE
  FULLY_DEPRECIATED
  DISPOSED
}

model FixedAsset {
  id                   String              @id @default(uuid()) @db.Uuid
  companyId            String              @map("company_id") @db.Uuid
  name                 String
  code                 String?
  category             String?
  purchaseDate         DateTime            @map("purchase_date") @db.Date
  purchaseCost         Decimal             @map("purchase_cost") @db.Decimal(19, 4)
  residualValue        Decimal             @default(0) @map("residual_value") @db.Decimal(19, 4)
  usefulLifeMonths     Int                 @map("useful_life_months")
  depreciationMethod   DepreciationMethod  @default(STRAIGHT_LINE) @map("depreciation_method")
  accumulatedDepr      Decimal             @default(0) @map("accumulated_depr") @db.Decimal(19, 4)
  netBookValue         Decimal             @default(0) @map("net_book_value") @db.Decimal(19, 4)
  status               AssetStatus         @default(ACTIVE)
  disposalDate         DateTime?           @map("disposal_date") @db.Date
  disposalAmount       Decimal?            @map("disposal_amount") @db.Decimal(19, 4)
  notes                String?
  createdBy            String              @map("created_by") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator             User                 @relation("FixedAssetCreatedBy", fields: [createdBy], references: [id])
  depreciationEntries DepreciationEntry[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("fixed_assets")
}

model DepreciationEntry {
  id          String   @id @default(uuid()) @db.Uuid
  assetId     String   @map("asset_id") @db.Uuid
  periodDate  DateTime @map("period_date") @db.Date
  amount      Decimal  @db.Decimal(19, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("depreciation_entries")
}

// ---------------------------------------------------------------------------
// Payroll
// ---------------------------------------------------------------------------

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PAID
}

model Employee {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  firstName       String         @map("first_name")
  lastName        String         @map("last_name")
  personalNumber  String?        @map("personal_number")
  email           String?
  phone           String?
  position        String?
  department      String?
  employmentType  EmploymentType @default(FULL_TIME) @map("employment_type")
  startDate       DateTime       @map("start_date") @db.Date
  endDate         DateTime?      @map("end_date") @db.Date
  grossSalary     Decimal        @default(0) @map("gross_salary") @db.Decimal(19, 4)
  bankAccount     String?        @map("bank_account")
  isActive        Boolean        @default(true) @map("is_active")
  createdBy       String         @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator  User          @relation("EmployeeCreatedBy", fields: [createdBy], references: [id])
  payslips Payslip[]

  @@index([companyId])
  @@map("employees")
}

model PayrollRun {
  id           String           @id @default(uuid()) @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  periodStart  DateTime         @map("period_start") @db.Date
  periodEnd    DateTime         @map("period_end") @db.Date
  status       PayrollRunStatus @default(DRAFT)
  totalGross   Decimal          @default(0) @map("total_gross") @db.Decimal(19, 4)
  totalNet     Decimal          @default(0) @map("total_net") @db.Decimal(19, 4)
  totalTax     Decimal          @default(0) @map("total_tax") @db.Decimal(19, 4)
  totalPension Decimal          @default(0) @map("total_pension") @db.Decimal(19, 4)
  createdBy    String           @map("created_by") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator  User      @relation("PayrollRunCreatedBy", fields: [createdBy], references: [id])
  payslips Payslip[]

  @@index([companyId])
  @@map("payroll_runs")
}

model Payslip {
  id                  String   @id @default(uuid()) @db.Uuid
  payrollRunId        String   @map("payroll_run_id") @db.Uuid
  employeeId          String   @map("employee_id") @db.Uuid
  grossSalary         Decimal  @map("gross_salary") @db.Decimal(19, 4)
  pensionEmployee     Decimal  @default(0) @map("pension_employee") @db.Decimal(19, 4)
  pensionEmployer     Decimal  @default(0) @map("pension_employer") @db.Decimal(19, 4)
  incomeTax           Decimal  @default(0) @map("income_tax") @db.Decimal(19, 4)
  netSalary           Decimal  @default(0) @map("net_salary") @db.Decimal(19, 4)
  overtimeHours       Decimal  @default(0) @map("overtime_hours") @db.Decimal(5, 2)
  overtimeAmount      Decimal  @default(0) @map("overtime_amount") @db.Decimal(19, 4)
  bonusAmount         Decimal  @default(0) @map("bonus_amount") @db.Decimal(19, 4)
  deductionAmount     Decimal  @default(0) @map("deduction_amount") @db.Decimal(19, 4)
  deductionNotes      String?  @map("deduction_notes")

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
  @@index([employeeId])
  @@map("payslips")
}

// ---------------------------------------------------------------------------
// Exchange Rates
// ---------------------------------------------------------------------------

model ExchangeRate {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @map("company_id") @db.Uuid
  baseCurrency   String   @default("EUR") @map("base_currency")
  targetCurrency String   @map("target_currency")
  rate           Decimal  @db.Decimal(19, 8)
  effectiveDate  DateTime @map("effective_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, baseCurrency, targetCurrency, effectiveDate])
  @@index([companyId, targetCurrency])
  @@map("exchange_rates")
}

// ---------------------------------------------------------------------------
// Quotes & Orders
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_INVOICED
  INVOICED
  CANCELLED
}

model Quote {
  id             String      @id @default(uuid()) @db.Uuid
  companyId      String      @map("company_id") @db.Uuid
  quoteNumber    String?     @map("quote_number")
  contactId      String      @map("contact_id") @db.Uuid
  issueDate      DateTime    @map("issue_date") @db.Date
  expiryDate     DateTime    @map("expiry_date") @db.Date
  currency       String      @default("EUR")
  subtotalAmount Decimal     @default(0) @map("subtotal_amount") @db.Decimal(19, 4)
  taxAmount      Decimal     @default(0) @map("tax_amount") @db.Decimal(19, 4)
  totalAmount    Decimal     @default(0) @map("total_amount") @db.Decimal(19, 4)
  status         QuoteStatus @default(DRAFT)
  notes          String?
  convertedToId  String?     @map("converted_to_id") @db.Uuid
  createdBy      String      @map("created_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact   Contact     @relation(fields: [contactId], references: [id])
  creator   User        @relation("QuoteCreatedBy", fields: [createdBy], references: [id])
  lines     QuoteLine[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("quotes")
}

model QuoteLine {
  id               String  @id @default(uuid()) @db.Uuid
  quoteId          String  @map("quote_id") @db.Uuid
  lineNumber       Int     @map("line_number")
  productServiceId String? @map("product_service_id") @db.Uuid
  description      String
  quantity         Decimal @db.Decimal(19, 4)
  unitPrice        Decimal @map("unit_price") @db.Decimal(19, 4)
  discountPercent  Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxAmount        Decimal @default(0) @map("tax_amount") @db.Decimal(19, 4)
  totalAmount      Decimal @default(0) @map("total_amount") @db.Decimal(19, 4)

  quote          Quote           @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productService ProductService? @relation(fields: [productServiceId], references: [id])

  @@index([quoteId])
  @@map("quote_lines")
}

model SalesOrder {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  orderNumber     String?          @map("order_number")
  contactId       String           @map("contact_id") @db.Uuid
  orderDate       DateTime         @map("order_date") @db.Date
  deliveryDate    DateTime?        @map("delivery_date") @db.Date
  currency        String           @default("EUR")
  subtotalAmount  Decimal          @default(0) @map("subtotal_amount") @db.Decimal(19, 4)
  taxAmount       Decimal          @default(0) @map("tax_amount") @db.Decimal(19, 4)
  totalAmount     Decimal          @default(0) @map("total_amount") @db.Decimal(19, 4)
  invoicedAmount  Decimal          @default(0) @map("invoiced_amount") @db.Decimal(19, 4)
  status          SalesOrderStatus @default(DRAFT)
  notes           String?
  quoteId         String?          @map("quote_id") @db.Uuid
  createdBy       String           @map("created_by") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact  Contact          @relation(fields: [contactId], references: [id])
  creator  User             @relation("SalesOrderCreatedBy", fields: [createdBy], references: [id])
  lines    SalesOrderLine[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id               String  @id @default(uuid()) @db.Uuid
  orderId          String  @map("order_id") @db.Uuid
  lineNumber       Int     @map("line_number")
  productServiceId String? @map("product_service_id") @db.Uuid
  description      String
  quantity         Decimal @db.Decimal(19, 4)
  unitPrice        Decimal @map("unit_price") @db.Decimal(19, 4)
  discountPercent  Decimal @default(0) @map("discount_percent") @db.Decimal(5, 2)
  taxAmount        Decimal @default(0) @map("tax_amount") @db.Decimal(19, 4)
  totalAmount      Decimal @default(0) @map("total_amount") @db.Decimal(19, 4)
  invoicedQty      Decimal @default(0) @map("invoiced_qty") @db.Decimal(19, 4)

  order          SalesOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productService ProductService? @relation(fields: [productServiceId], references: [id])

  @@index([orderId])
  @@map("sales_order_lines")
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

// Unique constraint on (companyId, invoiceNumber) is implemented as a PARTIAL
// index (WHERE invoice_number IS NOT NULL) via raw SQL in the initial migration.
model Invoice {
  id                   String        @id @default(uuid()) @db.Uuid
  companyId            String        @map("company_id") @db.Uuid
  invoiceNumber        String?       @map("invoice_number") // null while DRAFT, set on ISSUE
  contactId            String        @map("contact_id") @db.Uuid
  issueDate            DateTime      @map("issue_date") @db.Date
  dueDate              DateTime      @map("due_date") @db.Date
  currency             String        @default("EUR")
  exchangeRate         Decimal       @default(1) @map("exchange_rate") @db.Decimal(19, 4)
  subtotalAmount       Decimal       @default(0) @map("subtotal_amount") @db.Decimal(19, 4)
  taxAmount            Decimal       @default(0) @map("tax_amount") @db.Decimal(19, 4)
  totalAmount          Decimal       @default(0) @map("total_amount") @db.Decimal(19, 4)
  paidAmount           Decimal       @default(0) @map("paid_amount") @db.Decimal(19, 4)
  balanceDue           Decimal       @default(0) @map("balance_due") @db.Decimal(19, 4)
  status               InvoiceStatus @default(DRAFT)
  notes                String?
  postedJournalEntryId String?       @map("posted_journal_entry_id") @db.Uuid
  voidedJournalEntryId String?       @map("voided_journal_entry_id") @db.Uuid
  createdBy            String        @map("created_by") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator            User                @relation("InvoiceCreatedBy", fields: [createdBy], references: [id])
  contact            Contact             @relation(fields: [contactId], references: [id])
  postedJournalEntry JournalEntry?       @relation("InvoicePostedEntry", fields: [postedJournalEntryId], references: [id])
  voidedJournalEntry JournalEntry?       @relation("InvoiceVoidedEntry", fields: [voidedJournalEntryId], references: [id])
  lines              InvoiceLine[]
  paymentAllocations PaymentAllocation[]
  creditNotes        CreditNote[]
  fiscalCoupon       FiscalCoupon?
  posSale            PosSale?

  @@index([companyId])
  @@index([companyId, status])
  @@map("invoices")
}

model InvoiceLine {
  id               String        @id @default(uuid()) @db.Uuid
  invoiceId        String        @map("invoice_id") @db.Uuid
  lineNumber       Int           @map("line_number")
  productServiceId String?       @map("product_service_id") @db.Uuid
  description      String?
  quantity         Decimal       @db.Decimal(19, 4)
  unitPrice        Decimal       @map("unit_price") @db.Decimal(19, 4)
  discountType     DiscountType? @map("discount_type")
  discountValue    Decimal?      @map("discount_value") @db.Decimal(19, 4)
  taxRateId        String?       @map("tax_rate_id") @db.Uuid
  netAmount        Decimal       @default(0) @map("net_amount") @db.Decimal(19, 4)
  taxAmount        Decimal       @default(0) @map("tax_amount") @db.Decimal(19, 4)
  totalAmount      Decimal       @default(0) @map("total_amount") @db.Decimal(19, 4)
  incomeAccountId  String?       @map("income_account_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productService ProductService? @relation(fields: [productServiceId], references: [id])
  taxRate        TaxRate?        @relation(fields: [taxRateId], references: [id])
  incomeAccount  Account?        @relation(fields: [incomeAccountId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  companyId            String        @map("company_id") @db.Uuid
  contactId            String        @map("contact_id") @db.Uuid
  paymentType          PaymentType   @map("payment_type")
  paymentMethod        PaymentMethod @map("payment_method")
  paymentDate          DateTime      @map("payment_date") @db.Date
  referenceNumber      String?       @map("reference_number")
  currency             String        @default("EUR")
  exchangeRate         Decimal       @default(1) @map("exchange_rate") @db.Decimal(19, 4)
  totalAmount          Decimal       @map("total_amount") @db.Decimal(19, 4)
  status               PaymentStatus @default(RECORDED)
  notes                String?
  postedJournalEntryId String?       @map("posted_journal_entry_id") @db.Uuid
  voidedJournalEntryId String?       @map("voided_journal_entry_id") @db.Uuid
  createdBy            String        @map("created_by") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator            User                @relation("PaymentCreatedBy", fields: [createdBy], references: [id])
  contact            Contact             @relation(fields: [contactId], references: [id])
  postedJournalEntry JournalEntry?       @relation("PaymentPostedEntry", fields: [postedJournalEntryId], references: [id])
  voidedJournalEntry JournalEntry?       @relation("PaymentVoidedEntry", fields: [voidedJournalEntryId], references: [id])
  allocations        PaymentAllocation[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("payments")
}

model PaymentAllocation {
  id              String    @id @default(uuid()) @db.Uuid
  paymentId       String    @map("payment_id") @db.Uuid
  // Exactly one of invoiceId / billId is set (enforced in the service):
  // RECEIVED payments allocate to invoices, MADE payments to bills.
  invoiceId       String?   @map("invoice_id") @db.Uuid
  billId          String?   @map("bill_id") @db.Uuid
  allocatedAmount Decimal   @map("allocated_amount") @db.Decimal(19, 4)
  allocationDate  DateTime  @map("allocation_date") @db.Date
  isVoided        Boolean   @default(false) @map("is_voided")
  voidedAt        DateTime? @map("voided_at")
  createdBy       String    @map("created_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")

  payment Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  bill    Bill?    @relation(fields: [billId], references: [id])
  creator User     @relation("AllocationCreatedBy", fields: [createdBy], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@index([billId])
  @@map("payment_allocations")
}

// ---------------------------------------------------------------------------
// Purchases / Accounts Payable (Phase 1) — mirrors Sales/Invoice
// ---------------------------------------------------------------------------

model Bill {
  id                   String     @id @default(uuid()) @db.Uuid
  companyId            String     @map("company_id") @db.Uuid
  billNumber           String     @map("bill_number") // the vendor's invoice number (user-entered)
  contactId            String     @map("contact_id") @db.Uuid // vendor
  billDate             DateTime   @map("bill_date") @db.Date
  dueDate              DateTime   @map("due_date") @db.Date
  currency             String     @default("EUR")
  exchangeRate         Decimal    @default(1) @map("exchange_rate") @db.Decimal(19, 4)
  subtotalAmount       Decimal    @default(0) @map("subtotal_amount") @db.Decimal(19, 4)
  taxAmount            Decimal    @default(0) @map("tax_amount") @db.Decimal(19, 4)
  totalAmount          Decimal    @default(0) @map("total_amount") @db.Decimal(19, 4)
  paidAmount           Decimal    @default(0) @map("paid_amount") @db.Decimal(19, 4)
  balanceDue           Decimal    @default(0) @map("balance_due") @db.Decimal(19, 4)
  status               BillStatus @default(DRAFT)
  notes                String?
  postedJournalEntryId String?    @map("posted_journal_entry_id") @db.Uuid
  voidedJournalEntryId String?    @map("voided_journal_entry_id") @db.Uuid
  createdBy            String     @map("created_by") @db.Uuid
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator            User                @relation("BillCreatedBy", fields: [createdBy], references: [id])
  contact            Contact             @relation(fields: [contactId], references: [id])
  postedJournalEntry JournalEntry?       @relation("BillPostedEntry", fields: [postedJournalEntryId], references: [id])
  voidedJournalEntry JournalEntry?       @relation("BillVoidedEntry", fields: [voidedJournalEntryId], references: [id])
  lines              BillLine[]
  paymentAllocations PaymentAllocation[]
  creditNotes        CreditNote[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("bills")
}

model BillLine {
  id               String        @id @default(uuid()) @db.Uuid
  billId           String        @map("bill_id") @db.Uuid
  lineNumber       Int           @map("line_number")
  productServiceId String?       @map("product_service_id") @db.Uuid
  description      String?
  quantity         Decimal       @db.Decimal(19, 4)
  unitPrice        Decimal       @map("unit_price") @db.Decimal(19, 4)
  discountType     DiscountType? @map("discount_type")
  discountValue    Decimal?      @map("discount_value") @db.Decimal(19, 4)
  taxRateId        String?       @map("tax_rate_id") @db.Uuid
  netAmount        Decimal       @default(0) @map("net_amount") @db.Decimal(19, 4)
  taxAmount        Decimal       @default(0) @map("tax_amount") @db.Decimal(19, 4)
  totalAmount      Decimal       @default(0) @map("total_amount") @db.Decimal(19, 4)
  expenseAccountId String?       @map("expense_account_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  bill           Bill            @relation(fields: [billId], references: [id], onDelete: Cascade)
  productService ProductService? @relation(fields: [productServiceId], references: [id])
  taxRate        TaxRate?        @relation(fields: [taxRateId], references: [id])
  expenseAccount Account?        @relation(fields: [expenseAccountId], references: [id])

  @@index([billId])
  @@map("bill_lines")
}

// ---------------------------------------------------------------------------
// Credit Notes (Sales Returns / Vendor Credits)
// ---------------------------------------------------------------------------

model CreditNote {
  id                   String           @id @default(uuid()) @db.Uuid
  companyId            String           @map("company_id") @db.Uuid
  creditNoteNumber     String?          @map("credit_note_number") // null while DRAFT, set on ISSUE
  type                 CreditNoteType
  contactId            String           @map("contact_id") @db.Uuid
  issueDate            DateTime         @map("issue_date") @db.Date
  currency             String           @default("EUR")
  exchangeRate         Decimal          @default(1) @map("exchange_rate") @db.Decimal(19, 4)
  subtotalAmount       Decimal          @default(0) @map("subtotal_amount") @db.Decimal(19, 4)
  taxAmount            Decimal          @default(0) @map("tax_amount") @db.Decimal(19, 4)
  totalAmount          Decimal          @default(0) @map("total_amount") @db.Decimal(19, 4)
  status               CreditNoteStatus @default(DRAFT)
  reason               String?
  originalInvoiceId    String?          @map("original_invoice_id") @db.Uuid
  originalBillId       String?          @map("original_bill_id") @db.Uuid
  postedJournalEntryId String?          @map("posted_journal_entry_id") @db.Uuid
  voidedJournalEntryId String?          @map("voided_journal_entry_id") @db.Uuid
  createdBy            String           @map("created_by") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  company            Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator            User           @relation("CreditNoteCreatedBy", fields: [createdBy], references: [id])
  contact            Contact        @relation(fields: [contactId], references: [id])
  originalInvoice    Invoice?       @relation(fields: [originalInvoiceId], references: [id])
  originalBill       Bill?          @relation(fields: [originalBillId], references: [id])
  postedJournalEntry JournalEntry?  @relation("CreditNotePostedEntry", fields: [postedJournalEntryId], references: [id])
  voidedJournalEntry JournalEntry?  @relation("CreditNoteVoidedEntry", fields: [voidedJournalEntryId], references: [id])
  lines              CreditNoteLine[]
  fiscalCoupon       FiscalCoupon?

  @@index([companyId])
  @@index([companyId, status])
  @@index([companyId, type])
  @@map("credit_notes")
}

model CreditNoteLine {
  id               String        @id @default(uuid()) @db.Uuid
  creditNoteId     String        @map("credit_note_id") @db.Uuid
  lineNumber       Int           @map("line_number")
  productServiceId String?       @map("product_service_id") @db.Uuid
  description      String?
  quantity         Decimal       @db.Decimal(19, 4)
  unitPrice        Decimal       @map("unit_price") @db.Decimal(19, 4)
  discountType     DiscountType? @map("discount_type")
  discountValue    Decimal?      @map("discount_value") @db.Decimal(19, 4)
  taxRateId        String?       @map("tax_rate_id") @db.Uuid
  netAmount        Decimal       @default(0) @map("net_amount") @db.Decimal(19, 4)
  taxAmount        Decimal       @default(0) @map("tax_amount") @db.Decimal(19, 4)
  totalAmount      Decimal       @default(0) @map("total_amount") @db.Decimal(19, 4)
  accountId        String?       @map("account_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  creditNote     CreditNote      @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  productService ProductService? @relation(fields: [productServiceId], references: [id])
  taxRate        TaxRate?        @relation(fields: [taxRateId], references: [id])
  account        Account?        @relation(fields: [accountId], references: [id])

  @@index([creditNoteId])
  @@map("credit_note_lines")
}

// ---------------------------------------------------------------------------
// Document Sequencing
// ---------------------------------------------------------------------------

// All three columns are NON-NULLABLE, so a standard unique constraint is safe
// (no partial-index workaround needed).
model DocumentSequence {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @map("company_id") @db.Uuid
  documentType DocumentType @map("document_type")
  fiscalYear   Int          @map("fiscal_year")
  prefix       String
  lastNumber   Int          @default(0) @map("last_number")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, documentType, fiscalYear])
  @@index([companyId])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  occurredAt DateTime @default(now()) @map("occurred_at")
  ipAddress  String?  @map("ip_address")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([companyId, entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Fiscalization (Kosovo / ATK) — see FISCALIZATION.md
// ---------------------------------------------------------------------------

model CompanyFiscalConfig {
  id                  String         @id @default(uuid()) @db.Uuid
  companyId           String         @unique @map("company_id") @db.Uuid
  enabled             Boolean        @default(false)
  provider            FiscalProvider @default(NONE)
  environment         String         @default("TEST") // TEST | PRODUCTION
  businessUnitCode    String?        @map("business_unit_code") // POS/unit code registered with ATK
  operatorCode        String?        @map("operator_code")
  efsSoftwareCode     String?        @map("efs_software_code") // certified EFS identifier notified to ATK
  efsMaintainer       String?        @map("efs_maintainer")
  verificationBaseUrl String?        @map("verification_base_url") // ATK QR verification host
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_fiscal_configs")
}

model FiscalCoupon {
  id               String             @id @default(uuid()) @db.Uuid
  companyId        String             @map("company_id") @db.Uuid
  invoiceId        String?            @unique @map("invoice_id") @db.Uuid
  creditNoteId     String?            @unique @map("credit_note_id") @db.Uuid
  status           FiscalCouponStatus @default(PENDING)
  couponType       FiscalCouponType   @default(SALE) @map("coupon_type")
  provider         FiscalProvider     @default(NONE)
  totalAmount      Decimal            @default(0) @map("total_amount") @db.Decimal(19, 4)
  taxAmount        Decimal            @default(0) @map("tax_amount") @db.Decimal(19, 4)
  currency         String             @default("EUR")
  fcuin            String?            @map("fcuin") // Fiscal Coupon Unique Identification Number
  verificationUrl  String?            @map("verification_url")
  qrPayload        String?            @map("qr_payload")
  taxBlockCode     String?            @map("tax_block_code")
  businessUnitCode String?            @map("business_unit_code")
  operatorCode     String?            @map("operator_code")
  fiscalizedAt     DateTime?          @map("fiscalized_at")
  errorMessage     String?            @map("error_message")
  requestPayload   Json?              @map("request_payload")
  responsePayload  Json?              @map("response_payload")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  creditNote CreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
  @@map("fiscal_coupons")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

enum StockMovementType {
  GOODS_RECEIPT // purchase inbound
  GOODS_ISSUE // sale outbound
  TRANSFER_IN // warehouse transfer (receiving end)
  TRANSFER_OUT // warehouse transfer (sending end)
  ADJUSTMENT_IN // stocktake surplus
  ADJUSTMENT_OUT // stocktake shortage
  RETURN_IN // customer return
  RETURN_OUT // vendor return
}

model Warehouse {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  code        String
  name        String
  address     String?
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator        User            @relation("WarehouseCreatedBy", fields: [createdBy], references: [id])
  stockMovements StockMovement[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("warehouses")
}

model StockMovement {
  id               String            @id @default(uuid()) @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  warehouseId      String            @map("warehouse_id") @db.Uuid
  productServiceId String            @map("product_service_id") @db.Uuid
  type             StockMovementType
  quantity         Decimal           @db.Decimal(19, 4)
  unitCost         Decimal?          @map("unit_cost") @db.Decimal(19, 4)
  reference        String?           // document reference (e.g. INV-001, BILL-002)
  sourceDocumentId String?           @map("source_document_id") @db.Uuid
  sourceDocumentType String?         @map("source_document_type") // INVOICE, BILL, CREDIT_NOTE, TRANSFER, ADJUSTMENT
  notes            String?
  movementDate     DateTime          @map("movement_date") @db.Date
  createdBy        String            @map("created_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at")

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  productService ProductService @relation(fields: [productServiceId], references: [id])
  creator        User           @relation("StockMovementCreatedBy", fields: [createdBy], references: [id])

  @@index([companyId])
  @@index([companyId, warehouseId, productServiceId])
  @@index([companyId, productServiceId])
  @@index([sourceDocumentId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Point of Sale (POS)
// ---------------------------------------------------------------------------

enum PosSessionStatus {
  OPEN
  CLOSED
}

enum PosSaleStatus {
  COMPLETED
  VOIDED
}

enum PosPaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

model PosRegister {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions PosSession[]

  @@index([companyId])
  @@map("pos_registers")
}

model PosSession {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  registerId      String           @map("register_id") @db.Uuid
  openedBy        String           @map("opened_by") @db.Uuid
  closedBy        String?          @map("closed_by") @db.Uuid
  status          PosSessionStatus @default(OPEN)
  openingBalance  Decimal          @default(0) @map("opening_balance") @db.Decimal(19, 4)
  closingBalance  Decimal?         @map("closing_balance") @db.Decimal(19, 4)
  expectedBalance Decimal?         @map("expected_balance") @db.Decimal(19, 4)
  openedAt        DateTime         @default(now()) @map("opened_at")
  closedAt        DateTime?        @map("closed_at")

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  register PosRegister @relation(fields: [registerId], references: [id])
  opener   User       @relation("PosSessionOpenedBy", fields: [openedBy], references: [id])
  closer   User?      @relation("PosSessionClosedBy", fields: [closedBy], references: [id])
  sales    PosSale[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("pos_sessions")
}

model PosSale {
  id            String           @id @default(uuid()) @db.Uuid
  companyId     String           @map("company_id") @db.Uuid
  sessionId     String           @map("session_id") @db.Uuid
  saleNumber    Int              @map("sale_number")
  status        PosSaleStatus    @default(COMPLETED)
  paymentMethod PosPaymentMethod @map("payment_method")
  subtotal      Decimal          @default(0) @db.Decimal(19, 4)
  taxAmount     Decimal          @default(0) @map("tax_amount") @db.Decimal(19, 4)
  totalAmount   Decimal          @default(0) @map("total_amount") @db.Decimal(19, 4)
  amountPaid    Decimal          @default(0) @map("amount_paid") @db.Decimal(19, 4)
  changeGiven   Decimal          @default(0) @map("change_given") @db.Decimal(19, 4)
  currency      String           @default("EUR")
  invoiceId     String?          @unique @map("invoice_id") @db.Uuid
  customerName  String?          @map("customer_name")
  createdBy     String           @map("created_by") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  session  PosSession    @relation(fields: [sessionId], references: [id])
  invoice  Invoice?      @relation(fields: [invoiceId], references: [id])
  creator  User          @relation("PosSaleCreatedBy", fields: [createdBy], references: [id])
  lines    PosSaleLine[]

  @@index([companyId])
  @@index([sessionId])
  @@map("pos_sales")
}

model PosSaleLine {
  id               String  @id @default(uuid()) @db.Uuid
  saleId           String  @map("sale_id") @db.Uuid
  lineNumber       Int     @map("line_number")
  productServiceId String  @map("product_service_id") @db.Uuid
  name             String
  quantity         Decimal @db.Decimal(19, 4)
  unitPrice        Decimal @map("unit_price") @db.Decimal(19, 4)
  taxAmount        Decimal @default(0) @map("tax_amount") @db.Decimal(19, 4)
  totalAmount      Decimal @default(0) @map("total_amount") @db.Decimal(19, 4)

  sale           PosSale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productService ProductService @relation(fields: [productServiceId], references: [id])

  @@index([saleId])
  @@map("pos_sale_lines")
}
